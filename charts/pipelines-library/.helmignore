# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Chart unit tests (pytest) and their caches. The packaged chart is embedded
# in the Helm release Secret, which etcd caps at 1MiB - test code and
# __pycache__ left behind by a prior `make test-chart` run push it over.
tests/
__pycache__/
.pytest_cache/
*.pyc
